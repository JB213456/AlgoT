# Copy to .env and fill in before `docker compose up`.

# Comma-separated secret keys accepted by the market-data-db API (X-API-Key header).
# Generate with: openssl rand -hex 32
MARKET_DATA_DB_API_KEYS=change-me-to-a-long-random-secret

# Leave empty to use the default SQLite metadata store under the data volume.
# Set to a postgresql:// URL to use Postgres instead (recommended if you raise
# UVICORN_WORKERS above 1).
MARKET_DATA_DB_METADATA_URL=

UVICORN_WORKERS=1
LOG_LEVEL=INFO
MARKET_DATA_DB_HOST_PORT=8000
MARKET_DATA_DB_CPU_LIMIT=2.0
MARKET_DATA_DB_MEM_LIMIT=2g
