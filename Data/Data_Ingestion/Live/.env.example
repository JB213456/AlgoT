# Copy to .env and fill in your own Alpaca API credentials.
# Never commit the real .env file.

ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# iex is the free real-time feed. sip/otc/boats/overnight require a paid subscription.
ALPACA_DATA_FEED=iex

# Comma-separated list of instruments to ingest.
ALPACA_SYMBOLS=AAPL,MSFT,TSLA

# Comma-separated subset of: trades,quotes,bars,updated_bars,daily_bars,statuses
ALPACA_SUBSCRIPTIONS=trades,quotes,bars

# Seconds with no websocket message before the SDK forces a reconnect. Leave unset to disable.
ALPACA_WS_DATA_TIMEOUT=

# REST snapshot polling (supplements the websocket; set interval 0 to disable).
ALPACA_REST_POLL_INTERVAL_SECONDS=10
ALPACA_REST_RATE_LIMIT_PER_MINUTE=200

# How often the health monitor logs a status summary.
ALPACA_HEALTH_LOG_INTERVAL_SECONDS=30

# Max events buffered in the unified queue before oldest events are dropped.
ALPACA_QUEUE_MAX_SIZE=10000

LOG_LEVEL=INFO
