# Copy to .env (same directory as docker-compose.yml) and fill in real values.
# Never commit the real .env file.

# --- Alpaca (used by both live ingestion and backfill) ---
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_DATA_FEED=iex
ALPACA_SYMBOLS=AAPL,MSFT,TSLA
ALPACA_SUBSCRIPTIONS=trades,quotes,bars
ALPACA_WS_DATA_TIMEOUT=
ALPACA_REST_POLL_INTERVAL_SECONDS=10
ALPACA_REST_RATE_LIMIT_PER_MINUTE=200
ALPACA_HEALTH_LOG_INTERVAL_SECONDS=30
ALPACA_QUEUE_MAX_SIZE=10000
ALPACA_MAX_CONCURRENT_REQUESTS=4

# --- London Strategic Edge (backfill only) ---
LSE_API_KEY=your_lse_key_here
LSE_RATE_LIMIT_PER_MINUTE=60
LSE_MAX_ROWS_PER_DAY=12500000
LSE_MAX_BYTES_PER_WEEK=12884901888
LSE_MAX_ROWS_PER_EXPORT=2500000
LSE_MAX_CONCURRENT_DOWNLOADS=1

BACKFILL_MAX_RETRIES=5
BACKFILL_RETRY_BASE_DELAY_SECONDS=1.0

# --- market-data-db integration (separate image/container; see ../Database) ---
# Leave both blank to run ingestion with no shared-DB writes. Once that
# service is reachable (same Docker host, after `docker network connect
# algot-db-net algot-data-ingestion` -- see README), set:
#   MARKET_DATA_DB_URL=http://market-data-db:8000
#   MARKET_DATA_DB_API_KEY=<one of the comma-separated keys in that
#                            service's MARKET_DATA_DB_API_KEYS>
MARKET_DATA_DB_URL=
MARKET_DATA_DB_API_KEY=
# Intentionally blank in this example; set the key only in a private .env file.
LIVE_DB_FLUSH_INTERVAL_SECONDS=5
LIVE_HEARTBEAT_MAX_STALENESS_SECONDS=60

LOG_LEVEL=INFO

# Resource limits (docker-compose.yml deploy.resources)
INGESTION_CPU_LIMIT=2.0
INGESTION_MEM_LIMIT=1g
