# Copy to .env and fill in your own credentials. Never commit the real .env file.

# Alpaca (free IEX feed) — https://alpaca.markets
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here

# London Strategic Edge — https://londonstrategicedge.com (free key from the Data page)
LSE_API_KEY=your_lse_key_here

# Where the backfilled SQLite database lives. Point this at AlgoT/Database
# once that store exists, e.g. /home/james/AlgoT/Database/market_data.sqlite3
BACKFILL_DB_PATH=

# Free-tier quota knobs (defaults match documented free-tier limits; lower
# them if your plan differs).
ALPACA_REST_RATE_LIMIT_PER_MINUTE=200
ALPACA_MAX_CONCURRENT_REQUESTS=4
LSE_RATE_LIMIT_PER_MINUTE=60
LSE_MAX_ROWS_PER_DAY=12500000
LSE_MAX_BYTES_PER_WEEK=12884901888
LSE_MAX_ROWS_PER_EXPORT=2500000
LSE_MAX_CONCURRENT_DOWNLOADS=1

BACKFILL_MAX_RETRIES=5
BACKFILL_RETRY_BASE_DELAY_SECONDS=1.0

LOG_LEVEL=INFO
